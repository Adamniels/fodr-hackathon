# Backing services from compose.yaml (ADR 0006). Copy to `.env` at the repository root to change them;
# without a `.env`, compose.yaml uses these same defaults. Development only: never use these values elsewhere.
# The Anthropic key lives in apps/web/.env, not here.

POSTGRES_USER=fodr
POSTGRES_PASSWORD=fodr
POSTGRES_DB=fodr
POSTGRES_PORT=5432

# S3 compatible file store (SeaweedFS locally, ADR 0011).
S3_ACCESS_KEY_ID=fodr
S3_SECRET_ACCESS_KEY=fodr-dev-secret
S3_PORT=8333

# Mailpit: SMTP for outgoing email, and the web inbox.
SMTP_PORT=1025
MAILPIT_UI_PORT=8025
