            "description": "Korsförlamning, PSSM",
            "type": "boolean",
          },
          "ras": {
            "anyOf": [
              {
                "$ref": "#/$defs/__schema3",
              },
              {
                "type": "null",
              },
            ],
            "description": "Ras om den nämns. Halvblod räknas som varmblod_rid, kallblodstravare som nordsvensk",
          },
          "tandproblem": {
            "type": "boolean",
          },
          "undvik": {
            "description": "Ingredienser ägaren säger att hästen inte tål",
