{
  "compilerOptions": {
    "target": "ES2020",
    // ES only: no DOM and no Node, so I/O and platform APIs are type errors in the pure engine (ADR 0004, #67).
    "lib": ["ES2020"],
    "types": [],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["src", "test"]
}
