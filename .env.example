# Local development (ADR 0006, ADR 0015). Copy to `.env` at the repository root: compose.yaml reads the service
# values, and the API (apps/api) refuses to start without DATABASE_URL. Development only: never use these values
# elsewhere. Never commit `.env`: it holds the Anthropic key.

# Postgres. DATABASE_URL must match the values above it.
POSTGRES_USER=fodr
POSTGRES_PASSWORD=fodr
POSTGRES_DB=fodr
POSTGRES_PORT=5432
DATABASE_URL=postgres://fodr:fodr@localhost:5432/fodr

# S3 compatible file store (SeaweedFS locally, ADR 0011). Letters, digits, `-` and `_` only: the identity is written
# into JSON at start.
S3_ACCESS_KEY_ID=fodr
S3_SECRET_ACCESS_KEY=fodr-dev-secret
S3_PORT=8333
# The API's view of the store: S3_ENDPOINT must match S3_PORT. The API creates the bucket at start when it is missing.
S3_ENDPOINT=http://localhost:8333
S3_BUCKET=fodr

# Mailpit: SMTP for outgoing email, and the web inbox.
SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# The API. Vite proxies /api to this port. LOG_LEVEL: fatal, error, warn, info, debug, trace or silent.
PORT=3000
LOG_LEVEL=info
# The built web app, served by the API on the same origin. Set only in the production image (Dockerfile); in
# development Vite serves the web app.
# WEB_DIST_DIR=
# Auth (ADR 0009). The secret signs sessions and tokens: at least 32 characters, a fresh random one everywhere but
# here (for example `openssl rand -base64 32`). The URL is where the browser reaches the app: the Vite address in
# development, which proxies /api; the emailed links point there.
BETTER_AUTH_SECRET=dev-only-secret-change-me-at-least-32-chars
BETTER_AUTH_URL=http://localhost:5173
# The header a trusted proxy in front of the API sets to the client's IP (for example Fly-Client-IP), which the auth
# rate limits key on. Leave it unset when the API is reached directly, as here: the connection's address is used.
# CLIENT_IP_HEADER=

# Outgoing mail (ADR 0005): Mailpit's SMTP port locally (inbox on MAILPIT_UI_PORT). SMTP_USER and SMTP_PASSWORD are
# for a real provider and stay empty here.
SMTP_HOST=localhost
MAIL_FROM=Fodr <no-reply@fodr.local>
SMTP_USER=
SMTP_PASSWORD=

# The key for the AI routes (analysis reading, profile fill, explanations). Without it they answer with an error and
# everything else works.
ANTHROPIC_API_KEY=
